# Shopify shop domain (zonder https://)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Custom app client credentials (Admin API) — SERVER ONLY, nooit NEXT_PUBLIC_*
# Scopes vereist: read_customers, write_customers
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optioneel: Admin API versie (default: 2026-07)
SHOPIFY_ADMIN_API_VERSION=2026-07

# Storefront API (catalog / cart — later)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Public site URL (geen trailing slash)
# Local development: http://localhost:3000
# Production (Vercel): https://www.bionutz.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
